  m_text: "\uC720\uB2A5\uD55C \uAE30\uC220\uC790\uC774\uBA70 \uD3B8\uC9D1\uC99D\uC774
    \uC788\uB294 \uB4EF\uD558\uB2E4. \uC548\uC804\uAC00\uC625 \uBC16\uC5D0\uC11C\uB3C4
    \uBC29\uB3C5\uBA74\uC744 \uC4F0\uACE0 \uC870\uC5D8\uACFC \uC5D8\uB9AC\uB97C \uC81C\uC555\uD55C
